{
  "_comment": "PROFIL HASHIMOTO - VERSION BROUILLON. Ces règles sont un point de départ NON VALIDÉ médicalement. Elles doivent être relues et amendées par un professionnel de santé (médecin endocrinologue / diététicien-nutritionniste) avant tout lancement. Les clés commençant par '_' sont des commentaires ignorés par le moteur.",

  "_howToEdit": "Chaque règle se déclenche AU PLUS UNE FOIS. 'match' est un OU : la règle s'applique si au moins un critère correspond. Les identifiants sont les tags normalisés Open Food Facts (ex. en:wheat) : ils sont indépendants de la langue de l'étiquette. 'points' est ajouté (ou retiré) au score de base. 'reasonKey' renvoie à un texte dans src/i18n/messages/*.json. '*' dans allergens/traces = n'importe quelle valeur. Pour un autre profil (AIP, cœliaque...), copier ce fichier en rules/<profil>.json, adapter les règles, puis l'enregistrer dans rules/index.ts : aucun code du moteur à modifier.",

  "profile": "hashimoto",
  "version": "0.1.0-draft",
  "validation": {
    "status": "DRAFT",
    "validatedBy": null,
    "validatedOn": null,
    "_note": "Passer status à VALIDATED et renseigner validatedBy/validatedOn uniquement après relecture écrite par un professionnel de santé."
  },

  "scoring": {
    "base": 50,
    "min": 0,
    "max": 100,
    "_thresholds": "score >= green => vert ; >= orange => orange ; sinon rouge.",
    "thresholds": { "green": 65, "orange": 40 },
    "_caps": "Plafond du cumul des bonus, pour qu'un produit très mauvais par ailleurs ne soit pas 'sauvé' par quelques points positifs.",
    "caps": { "maxBonus": 30 }
  },

  "dataRequirements": {
    "_comment": "En dessous de ce nombre d'ingrédients normalisés (et sans additifs), on affiche 'données insuffisantes' plutôt qu'un score inventé.",
    "minIngredientTags": 1
  },

  "rules": [
