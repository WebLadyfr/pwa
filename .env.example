# Copier ce fichier vers .env.local (dev) ou le renseigner dans Vercel > Settings > Environment Variables.
# NE JAMAIS mettre de vraie valeur dans ce fichier, qui est versionné.
# Aucune variable secrète n'est préfixée NEXT_PUBLIC_ (exposée au navigateur). Seule exception : le DSN Sentry (non secret).

# Clé API Anthropic (serveur uniquement, utilisée par /api/label)
ANTHROPIC_API_KEY=

# Modèle utilisé pour lire les étiquettes (vision). Voir la doc Anthropic pour les IDs en vigueur.
ANTHROPIC_MODEL=claude-haiku-5-5

# User-Agent envoyé à Open Food Facts (OBLIGATOIRE de s'identifier : nom de l'app + contact)
OFF_USER_AGENT=Immulea/0.1 (contact: votre-adresse@exemple.fr)

# --- Rapports d'erreur (Sentry, région UE) : OPTIONNEL, désactivé par défaut côté utilisateur (opt-in dans Réglages) ---
# DSN du projet Sentry EU, format https://<clé>@o<id>.ingest.de.sentry.io/<projet>.
# Un DSN n'est pas un secret (il ne permet qu'envoyer des événements) mais reste hors du code et de Git.
# Seule la région UE (*.ingest.de.sentry.io) est acceptée ; autre chose = Sentry désactivé.
# Fixé au BUILD (préfixe NEXT_PUBLIC_) : à définir avant le déploiement. Laisser vide pour désactiver.
NEXT_PUBLIC_SENTRY_DSN=

# Rate limiting (par IP, en mémoire de l'instance serverless)
LABEL_RATE_LIMIT_PER_10MIN=5
PRODUCT_RATE_LIMIT_PER_MIN=60
SEARCH_RATE_LIMIT_PER_MIN=20

# Plafond quotidien global d'appels Claude (garde-fou de coût, par instance)
LABEL_DAILY_BUDGET=500

# --- Recettes générées par IA (route /api/recipes) ---
# Modèle (défaut : claude-haiku-5-5) et plafond de tokens de sortie par appel (plafond dur : 4000).
RECIPE_MODEL=claude-haiku-5-5
RECIPE_MAX_TOKENS=2500
# Réflexion : désactivée par défaut (sinon les tokens cachés mangent max_tokens et le JSON est coupé : mesuré).
# Si vous changez RECIPE_MODEL pour un modèle qui refuse « thinking disabled » (Opus 5.5, Sonnet 5.5),
# décommentez RECIPE_THINKING=on ET relevez RECIPE_MAX_TOKENS (4000 maximum).
RECIPE_EFFORT=low
# RECIPE_THINKING=on
# Quota gratuit mensuel par appareil/IP, limite de débit (10 min) et plafond GLOBAL quotidien (garde-fou de coût).
RECIPE_FREE_MONTHLY_QUOTA=10
RECIPES_RATE_LIMIT_PER_10MIN=6
RECIPES_DAILY_BUDGET=2000
# Durée de vie du cache des recettes « scan » (secondes ; défaut 7 jours).
RECIPE_CACHE_TTL_SEC=604800
# Magasin Redis PARTAGÉ (rate limit, quota, cache) : Upstash Redis ou Vercel KV (API REST, HTTPS obligatoire).
# En PRODUCTION, sans Redis + sel ci-dessous, la fonction recettes est désactivée (message « indisponible ») : voulu.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (équivalents Vercel KV : KV_REST_API_URL / KV_REST_API_TOKEN)
# Sel secret (>= 16 caractères aléatoires) pour pseudonymiser les IP dans Redis. Ne jamais le changer sans nécessité (remet les quotas à zéro).
RECIPES_IP_SALT=
# Développement / test local en mode production (npm start) UNIQUEMENT : autorise un magasin en mémoire. Jamais en production réelle.
# RECIPES_ALLOW_MEMORY_STORE=true

# Adresse de contact affichee dans Reglages > A propos > Contact (publique, a renseigner)
NEXT_PUBLIC_CONTACT_EMAIL=
