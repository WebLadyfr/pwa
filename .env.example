# Copier ce fichier vers .env.local (dev) ou le renseigner dans Vercel > Settings > Environment Variables.
# NE JAMAIS mettre de vraie valeur dans ce fichier, qui est versionné.
# Aucune variable secrète n'est préfixée NEXT_PUBLIC_ (exposée au navigateur). Seule exception : le DSN Sentry (non secret).

# Clé API Anthropic (serveur uniquement, utilisée par /api/label)
ANTHROPIC_API_KEY=

# Modèle utilisé pour lire les étiquettes (vision). Voir la doc Anthropic pour les IDs en vigueur.
ANTHROPIC_MODEL=claude-haiku-5-5

# User-Agent envoyé à Open Food Facts (OBLIGATOIRE de s'identifier : nom de l'app + contact)
OFF_USER_AGENT=HashimotoScan/0.1 (contact: votre-adresse@exemple.fr)

# --- Rapports d'erreur (Sentry, région UE) : OPTIONNEL, désactivé par défaut côté utilisateur (opt-in dans Réglages) ---
# DSN du projet Sentry EU, format https://<clé>@o<id>.ingest.de.sentry.io/<projet>.
# Un DSN n'est pas un secret (il ne permet qu'envoyer des événements) mais reste hors du code et de Git.
# Seule la région UE (*.ingest.de.sentry.io) est acceptée ; autre chose = Sentry désactivé.
# Fixé au BUILD (préfixe NEXT_PUBLIC_) : à définir avant le déploiement. Laisser vide pour désactiver.
NEXT_PUBLIC_SENTRY_DSN=

# Rate limiting (par IP, en mémoire de l'instance serverless)
LABEL_RATE_LIMIT_PER_10MIN=5
PRODUCT_RATE_LIMIT_PER_MIN=60
SEARCH_RATE_LIMIT_PER_MIN=20

# Plafond quotidien global d'appels Claude (garde-fou de coût, par instance)
LABEL_DAILY_BUDGET=500
